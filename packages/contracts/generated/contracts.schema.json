        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "title": "Idempotency Key",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/RenderProfile"
