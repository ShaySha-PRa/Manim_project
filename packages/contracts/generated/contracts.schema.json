      "additionalProperties": false,
      "properties": {
        "extend_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 5,
          "title": "Extend Seconds",
          "type": "integer"
        },
        "lease_token": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Token",
          "type": "string"
        }
      },
      "required": [
        "lease_token"
      ],
      "title": "RenderJobHeartbeat",
      "type": "object"
