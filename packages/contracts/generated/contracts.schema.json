        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/GenerationStage"
        },
        "status": {
          "$ref": "#/$defs/GenerationStatus"
        }
      },
      "required": [
        "id",
        "project_id",
        "owner_id",
        "stage",
        "attempt_number",
        "status",
