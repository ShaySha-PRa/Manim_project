        "code_version_id": {
          "format": "uuid",
          "title": "Code Version Id",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_token": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Token",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/RenderProfile"
        }
      },
      "required": [
        "job_id",
        "code_version_id",
        "profile",
        "lease_token",
        "lease_expires_at",
        "attempt_number"
      ],
      "title": "RenderJobLease",
      "type": "object"
    },
