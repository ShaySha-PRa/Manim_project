        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
