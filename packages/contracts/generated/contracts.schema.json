        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "parent_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Version Id"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/ContentPlanScene"
