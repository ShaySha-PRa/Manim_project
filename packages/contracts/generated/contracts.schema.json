        },
        "runner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,99}$",
          "title": "Runner Id",
          "type": "string"
        }
      },
      "required": [
        "runner_id"
      ],
      "title": "RenderJobLeaseRequest",
      "type": "object"
