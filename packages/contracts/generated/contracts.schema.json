        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_duration_seconds": {
          "maximum": 600,
          "minimum": 15,
          "title": "Target Duration Seconds",
          "type": "integer"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "project_id",
        "owner_id",
        "version",
        "parent_version_id",
        "created_at",
        "schema_version",
        "title",
        "audience",
        "language",
        "target_duration_seconds",
        "explicit_assumptions",
        "scenes"
      ],
      "title": "ContentPlanVersion",
      "type": "object"
