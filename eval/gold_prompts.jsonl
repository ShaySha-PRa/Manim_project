{"id":"formula_001","category":"formula_derivation","persona":"初高中数学教师","audience":"k12","difficulty":"introductory","topic":"一元一次方程等价变形","prompt":"请用逐步动画推导并求解方程 3x-5=16，解释等式两边同时加减和同除以非零数的依据。","teaching_goal":"理解等式等价变形并得到 x=7。","must_include":["3x-5=16 → 3x=21 → x=7","两边同加5","两边同除以3","代回验证 3×7-5=16"],"must_avoid":["只说移项而不解释等价变形","除以未知数 x","最终解不是 x=7"],"expected_scene_structure":["展示原方程与目标","两边同加5并保持平衡","两边同除以3","代回原式验证"],"duration_seconds":{"min":35,"target":50,"max":70},"correctness_checks":["每一步与前一步等价","最终答案为 x=7","代回左侧等于16"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-k12"},"review":{"status":"parent_validated","notes":"父 agent 逐步复核等价变形和代回结果。"}}
{"id":"formula_002","category":"formula_derivation","persona":"初高中数学教师","audience":"k12","difficulty":"intermediate","topic":"二次方程配方法","prompt":"动画推导如何用配方法解 x²+6x+5=0，并说明为什么等式两边要同时加上9。","teaching_goal":"理解完全平方构造并掌握配方法。","must_include":["x²+6x=-5","9=(6/2)²","x²+6x+9=4","(x+3)²=4","x=-1 或 x=-5"],"must_avoid":["只在一侧加9","开平方时遗漏±","只给一个根"],"expected_scene_structure":["原方程移常数项","等式两边同时加9","构造完全平方","开平方得到两个解","代回验证"],"duration_seconds":{"min":60,"target":90,"max":120},"correctness_checks":["(-1)²+6(-1)+5=0","(-5)²+6(-5)+5=0","平方根步骤包含±2"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-k12"},"review":{"status":"parent_validated","notes":"父 agent 复核配方常数、两个根及代回结果。"}}
{"id":"formula_003","category":"formula_derivation","persona":"初高中数学教师","audience":"k12","difficulty":"intermediate","topic":"等差数列前n项和","prompt":"请推导等差数列前 n 项和公式，并用 1+3+5+…+(2n-1) 说明结果为什么是 n²。","teaching_goal":"理解正序倒序配对法和等差数列求和公式。","must_include":["Sₙ=a₁+a₂+…+aₙ","倒序排列","2Sₙ=n(a₁+aₙ)","Sₙ=n(a₁+aₙ)/2","1+3+…+(2n-1)=n²"],"must_avoid":["把项数写成 n-1","把末项写成 2n+1","配对后忘记除以2"],"expected_scene_structure":["展开一般等差数列","正序与倒序对齐","逐列配对","推出一般公式","代入奇数列验证"],"duration_seconds":{"min":70,"target":100,"max":130},"correctness_checks":["共有 n 项","每一对和为 a₁+aₙ","奇数列首项1末项2n-1","代入后结果为n²"],"ambiguities":["是否追加方块面积直观由后续视觉规划决定"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-k12"},"review":{"status":"parent_validated","notes":"父 agent 复核项数、末项及一般公式。"}}
{"id":"formula_004","category":"formula_derivation","persona":"初高中数学教师","audience":"k12","difficulty":"introductory","topic":"平方差恒等式","prompt":"用代数展开和面积直观推导 a²-b²=(a-b)(a+b)，再用它计算 25²-24²。","teaching_goal":"理解平方差公式来源并用于快速计算。","must_include":["(a-b)(a+b)=a²+ab-ab-b²","交叉项抵消","a²-b²=(a-b)(a+b)","25²-24²=1×49=49"],"must_avoid":["写成(a-b)²","遗漏ab与-ab","数值结果不是49"],"expected_scene_structure":["展示面积差或代数目标","展开乘积","抵消交叉项","得到恒等式","应用到数值例题"],"duration_seconds":{"min":45,"target":70,"max":95},"correctness_checks":["乘法展开正确","恒等式对任意实数a,b成立","25²-24²=49"],"ambiguities":["面积模型需保持a≥b≥0，代数恒等式不受此限制"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-k12"},"review":{"status":"parent_validated","notes":"父 agent 复核展开式及面积模型适用前提。"}}
{"id":"formula_005","category":"formula_derivation","persona":"初高中数学教师","audience":"k12","difficulty":"intermediate","topic":"对数乘法法则","prompt":"从 10ᵘ=M、10ᵛ=N 推导 log₁₀(MN)=log₁₀M+log₁₀N，并标出 M>0、N>0。","teaching_goal":"理解指数乘法如何导出对数乘法法则。","must_include":["M>0且N>0","10ᵘ=M 与 10ᵛ=N","MN=10ᵘ10ᵛ=10ᵘ⁺ᵛ","log₁₀(MN)=u+v","u=log₁₀M 与 v=log₁₀N"],"must_avoid":["把log(MN)写成logM×logN","忽略真数为正","改变对数底数"],"expected_scene_structure":["声明条件和变量","指数式相乘","合并指数","取以10为底的对数","代回u与v"],"duration_seconds":{"min":55,"target":80,"max":105},"correctness_checks":["M,N和MN均为正","指数法则10ᵘ10ᵛ=10ᵘ⁺ᵛ","最终等式为两对数之和"],"ambiguities":["首版固定底数10，不扩展一般底数"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-k12"},"review":{"status":"parent_validated","notes":"父 agent 复核定义域和指数到对数的转换。"}}
{"id":"formula_006","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"introductory","topic":"导数定义","prompt":"用导数定义推导 f(x)=x² 的导数，展示差商化简和 h→0 的过程。","teaching_goal":"理解导数是差商极限并得到 f′(x)=2x。","must_include":["f′(x)=lim(h→0)[(x+h)²-x²]/h","(x+h)²=x²+2xh+h²","h≠0时约去h","lim(h→0)(2x+h)=2x"],"must_avoid":["把(x+h)²展开成x²+h²","直接令h=0后再约分","导数写成x"],"expected_scene_structure":["割线斜率引入","写出差商","展开并约分","让h趋于0","显示切线斜率"],"duration_seconds":{"min":75,"target":105,"max":135},"correctness_checks":["h≠0阶段才约分","展开式包含2xh","最终导数为2x","x=2时斜率为4"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核差商代数和极限步骤。"}}
{"id":"formula_007","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"advanced","topic":"乘积求导法则","prompt":"从导数定义推导乘积法则，并用 x²sin x 验证。","teaching_goal":"理解乘积差商通过加减同一项拆分为两个变化率。","must_include":["[u(x+h)v(x+h)-u(x)v(x)]/h","加减u(x+h)v(x)","拆成两个差商","(uv)′=u′v+uv′","(x²sin x)′=2x sin x+x²cos x"],"must_avoid":["把乘积导数写成u′v′","加减项后改变原式","取极限时遗漏u(x+h)→u(x)"],"expected_scene_structure":["写出乘积差商","加入并减去中间项","分组为两个差商","分别取极限","应用到示例"],"duration_seconds":{"min":105,"target":145,"max":180},"correctness_checks":["加减项代数恒等","两个差商极限分别对应u′和v′","示例导数正确"],"ambiguities":["默认u和v在该点可导"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核中间项拆分和示例求导。"}}
{"id":"formula_008","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"intermediate","topic":"链式法则","prompt":"用内外函数的变化率解释链式法则，再求 d/dx[sin(x²)]。","teaching_goal":"理解复合函数求导时外层导数与内层导数相乘。","must_include":["y=f(u), u=g(x)","dy/dx=(dy/du)(du/dx)","u=x²","d/dx[sin(x²)]=2x cos(x²)"],"must_avoid":["遗漏内函数导数2x","把cos(x²)写成cos²x","混淆中间变量"],"expected_scene_structure":["展示函数嵌套","引入中间变量u","显示两级变化率","组合为链式法则","完成示例"],"duration_seconds":{"min":65,"target":95,"max":125},"correctness_checks":["外函数导数为cos u","内函数导数为2x","最终结果为2x cos(x²)"],"ambiguities":["变化率分式仅作直观记号，不作为严格约分证明"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核变量替换和最终导数。"}}
{"id":"formula_009","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"intermediate","topic":"局部线性化","prompt":"推导 f(x)=ln x 在 x=1 处的切线方程，并用它近似 ln(1.1)。","teaching_goal":"掌握切线公式和局部线性近似。","must_include":["ln1=0","f′(x)=1/x且f′(1)=1","L(x)=f(1)+f′(1)(x-1)=x-1","ln(1.1)≈0.1"],"must_avoid":["把ln1写成1","把近似号写成等号","在线性化点之外宣称精确相等"],"expected_scene_structure":["绘制或描述ln x","标记(1,0)","求该点导数","写出切线","用切线估算1.1处函数值"],"duration_seconds":{"min":55,"target":85,"max":110},"correctness_checks":["切线经过(1,0)","切线斜率为1","L(1.1)=0.1","真实ln(1.1)约0.0953并非恰等于0.1"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 数值复核 ln(1.1)≈0.09531，确认近似方向。"}}
{"id":"formula_010","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"introductory","topic":"幂函数不定积分","prompt":"从导数公式反推 ∫xⁿdx=xⁿ⁺¹/(n+1)+C，注明 n≠-1，并用 n=2 验证。","teaching_goal":"理解幂函数积分公式、积分常数及例外条件。","must_include":["d/dx[xⁿ⁺¹]=(n+1)xⁿ","n≠-1","∫xⁿdx=xⁿ⁺¹/(n+1)+C","∫x²dx=x³/3+C","对结果求导验证"],"must_avoid":["遗漏+C","把公式用于n=-1","分母写成n"],"expected_scene_structure":["回顾幂函数求导","反向调整系数","写出积分公式和条件","代入n=2","求导验证"],"duration_seconds":{"min":60,"target":90,"max":115},"correctness_checks":["结果求导恢复xⁿ","n=-1时应为ln|x|+C而非套用公式","n=2示例正确"],"ambiguities":["n取可应用幂函数求导法则的实数且在相应定义域讨论"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核导数逆运算和n=-1例外。"}}
{"id":"formula_011","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"advanced","topic":"微积分基本定理","prompt":"用面积累积函数解释：若 F(x)=∫ₐˣf(t)dt，则 F′(x)=f(x)，并用 f(t)=2t、a=0 验证。","teaching_goal":"理解累积积分的瞬时变化率等于当前被积函数值。","must_include":["F(x+h)-F(x)=∫ₓˣ⁺ʰf(t)dt","差商(1/h)∫ₓˣ⁺ʰf(t)dt","h→0时得到f(x)","∫₀ˣ2t dt=x²","F′(x)=2x"],"must_avoid":["混淆积分变量t与上限x","把增量区间写错","不说明连续性等适用条件"],"expected_scene_structure":["显示累积面积","上限从x移动到x+h","突出新增窄条","形成差商并取极限","用2t示例验证"],"duration_seconds":{"min":110,"target":150,"max":180},"correctness_checks":["增量积分区间为[x,x+h]","示例积分为x²","示例导数为2x","默认f在x附近连续"],"ambiguities":["这是直观推导，严格证明所需条件在规划中说明"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核增量积分、示例原函数及连续性前提。"}}
{"id":"formula_012","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"intermediate","topic":"积分变量代换","prompt":"推导 ∫2x cos(x²)dx 的变量代换过程，令 u=x²，并通过求导验证。","teaching_goal":"理解复合结构中的微分代换。","must_include":["u=x²","du=2x dx","∫2x cos(x²)dx=∫cos u du","sin u+C=sin(x²)+C","对sin(x²)求导验证"],"must_avoid":["把du写成x dx","把∫cos u du写成cos u","忘记换回x或遗漏+C"],"expected_scene_structure":["识别内层x²及其导数","执行变量代换","完成简单积分","换回原变量","求导验证"],"duration_seconds":{"min":50,"target":75,"max":100},"correctness_checks":["du=2x dx","∫cos u du=sin u+C","d/dx[sin(x²)]=2x cos(x²)"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核代换微分与反向求导。"}}
{"id":"formula_013","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"intermediate","topic":"分部积分","prompt":"从乘积求导公式推导分部积分公式，并计算 ∫x eˣdx。","teaching_goal":"理解分部积分公式来源和变量选择。","must_include":["d(uv)=u dv+v du","∫u dv=uv-∫v du","u=x且dv=eˣdx","du=dx且v=eˣ","∫x eˣdx=eˣ(x-1)+C"],"must_avoid":["把减号写成加号","错误积分eˣ","遗漏+C"],"expected_scene_structure":["写出乘积微分","移项并积分","选择u和dv","代入公式","化简并求导验证"],"duration_seconds":{"min":75,"target":110,"max":140},"correctness_checks":["d/dx[eˣ(x-1)]=x eˣ","分部积分公式为减号","v=eˣ"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核公式符号及结果导数。"}}
{"id":"formula_014","category":"formula_derivation","persona":"大学高数教师","audience":"college","difficulty":"advanced","topic":"三角函数基本极限","prompt":"用单位圆夹逼法推导 lim(x→0) sin x/x=1，明确角度必须使用弧度制。","teaching_goal":"理解基本极限的几何来源和夹逼定理。","must_include":["0<x<π/2时 sin x<x<tan x","cos x<sin x/x<1","x→0时cos x→1","夹逼得到右极限1","利用对称性得到双侧极限"],"must_avoid":["使用角度制却得到相同结论","写反不等式","只证明右极限却宣称双侧极限"],"expected_scene_structure":["单位圆与三种面积","推出sin x<x<tan x","整理为夹逼不等式","令x趋于0","补充负侧对称性"],"duration_seconds":{"min":125,"target":165,"max":180},"correctness_checks":["全部角度以弧度计","正侧夹逼不等式正确","sin(-x)/(-x)=sin x/x","最终双侧极限为1"],"ambiguities":["几何面积证明仅在0<x<π/2展示"],"source":{"type":"synthetic_interview","agent":"Bohr (Luna)","interview_id":"synthetic-bohr-college"},"review":{"status":"parent_validated","notes":"父 agent 复核单位圆不等式、除法方向和偶对称性。"}}
{"id":"formula_015","category":"formula_derivation","persona":"K12教辅课程编辑","audience":"k12","difficulty":"advanced","topic":"二次方程求根公式","prompt":"从 ax²+bx+c=0 推导求根公式，必须说明 a≠0，展示配方法，并解释判别式大于、等于、小于0时实根的情况。","teaching_goal":"理解求根公式来自等价变形和配方法，并认识判别式。","must_include":["a≠0","两边同除以a","(x+b/2a)²=(b²-4ac)/(4a²)","x=(-b±√(b²-4ac))/(2a)","Δ=b²-4ac的三种实根情况"],"must_avoid":["遗漏±","把a=0纳入二次方程","声称Δ<0仍有实根","配方法跳步导致不等价"],"expected_scene_structure":["标准方程与条件","除以a并移项","完成平方","开平方","整理求根公式","按判别式分类"],"duration_seconds":{"min":100,"target":140,"max":180},"correctness_checks":["每一步在a≠0条件下等价","最终分母为2a","Δ>0两个不等实根、Δ=0一个二重实根、Δ<0无实根"],"ambiguities":["首版只讨论实数范围，不展开复根"],"source":{"type":"synthetic_interview","agent":"Confucius (Luna)","interview_id":"synthetic-confucius-editor"},"review":{"status":"parent_validated","notes":"父 agent 独立重做配方法并复核判别式分类。"}}
{"id":"function_001","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"introductory","topic":"二次函数基本图像","prompt":"绘制 y=x²，展示顶点、对称轴、开口方向和最小值，并说明左右两侧的变化。","teaching_goal":"理解最基本抛物线的关键性质。","must_include":["完整坐标轴和y=x²","顶点(0,0)","对称轴x=0","开口向上且最小值0","定义域为全体实数"],"must_avoid":["把顶点称为最大值","只画x≥0却暗示完整定义域","曲线不关于y轴对称"],"expected_scene_structure":["建立坐标系","逐步绘制抛物线","标注顶点和对称轴","演示左右对称","总结最小值和定义域"],"duration_seconds":{"min":35,"target":50,"max":70},"correctness_checks":["f(-x)=f(x)","f(x)≥0","唯一顶点为(0,0)","定义域为实数"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核顶点、对称性、值域和定义域。"}}
{"id":"function_002","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"intermediate","topic":"抛物线参数变换","prompt":"用参数序列展示 y=a(x-h)²+k 中 a、h、k 分别变化时的开口、宽窄、顶点和平移规律。","teaching_goal":"建立顶点式参数与图像变换的对应关系。","must_include":["a≠0","顶点(h,k)","对称轴x=h","a的符号控制开口","|a|越大图像越窄"],"must_avoid":["把顶点写成(-h,k)","a=0时仍称二次函数","把h的平移方向写反"],"expected_scene_structure":["显示基准y=x²","只改变h","只改变k","只改变a的大小","改变a的符号","总结参数作用"],"duration_seconds":{"min":70,"target":95,"max":125},"correctness_checks":["代入x=h得到y=k","a>0开口向上且a<0向下","h增加使顶点向右","k增加使顶点向上"],"ambiguities":["首版生成预渲染参数序列，不承诺真实交互滑块"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核顶点式、开口与平移方向。"}}
{"id":"function_003","category":"function_visualization","persona":"数学科普创作者","audience":"general_creator","difficulty":"intermediate","topic":"正弦函数参数","prompt":"展示 y=A sin(ωx+φ)+D 的振幅、周期、相位和平移变化，并保留一条基准正弦曲线。","teaching_goal":"直观看到正弦函数各参数对图像的独立作用。","must_include":["A>0且ω>0的演示范围","振幅A","周期T=2π/ω","中线y=D","水平位移为-φ/ω"],"must_avoid":["把周期写成2πω","把φ直接说成水平位移","允许ω=0仍讨论周期"],"expected_scene_structure":["绘制基准曲线","改变A","改变ω","改变φ","改变D","并排总结四种影响"],"duration_seconds":{"min":65,"target":90,"max":120},"correctness_checks":["最大最小值为D±A","周期为2π/ω","φ变化方向符合-φ/ω","中线为y=D"],"ambiguities":["若需要负A，先转化为相位变化后另立样例"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-creator"},"review":{"status":"parent_validated","notes":"父 agent 复核周期、振幅、中线及相位位移。"}}
{"id":"function_004","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"introductory","topic":"指数函数底数变化","prompt":"比较 y=aˣ 在 a>1 和 0<a<1 时的图像，标出共同点、单调性和水平渐近线。","teaching_goal":"理解指数函数底数对增减性和端行为的影响。","must_include":["a>0且a≠1","所有曲线经过(0,1)","a>1时递增","0<a<1时递减","水平渐近线y=0"],"must_avoid":["使用a≤0作为实指数函数底数","把渐近线画成x=0","让曲线与x轴相交"],"expected_scene_structure":["显示参数条件","绘制a>1示例","绘制0<a<1示例","比较共同点和单调性","突出y=0渐近线"],"duration_seconds":{"min":45,"target":65,"max":85},"correctness_checks":["a⁰=1","函数值始终大于0","两种底数范围的单调性正确","两端趋势正确"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核定义条件、共同点、单调性和渐近线。"}}
{"id":"function_005","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"intermediate","topic":"指数与对数互为反函数","prompt":"同时绘制 y=eˣ 与 y=ln x，通过关于 y=x 的镜像动画说明它们互为反函数。","teaching_goal":"理解反函数交换定义域和值域，并在图像上关于y=x对称。","must_include":["y=eˣ与y=ln x","对称线y=x","eˣ定义域R和值域(0,∞)","ln x定义域(0,∞)和值域R","对应点坐标交换"],"must_avoid":["在x≤0处绘制ln x","混淆eˣ与xᵉ","关于错误直线镜像"],"expected_scene_structure":["绘制指数函数","显示y=x","把关键点坐标交换","镜像生成对数函数","总结定义域和值域"],"duration_seconds":{"min":55,"target":75,"max":100},"correctness_checks":["ln(eˣ)=x","e^(ln x)=x仅对x>0","两曲线关于y=x对称","(0,1)与(1,0)互换"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核反函数恒等式及定义域限制。"}}
{"id":"function_006","category":"function_visualization","persona":"数学科普创作者","audience":"general_creator","difficulty":"introductory","topic":"反比例函数","prompt":"绘制 y=k/x，用参数序列改变 k 的正负和大小，展示定义域、渐近线与象限变化。","teaching_goal":"理解k的符号和绝对值如何影响双曲线。","must_include":["x≠0且k≠0","渐近线x=0与y=0","k>0位于第一三象限","k<0位于第二四象限","曲线不穿过坐标轴"],"must_avoid":["在x=0取点","曲线穿过原点","k=0时仍称反比例函数"],"expected_scene_structure":["声明定义域和参数范围","绘制k>0","切换到k<0","改变|k|","总结象限和渐近线"],"duration_seconds":{"min":45,"target":65,"max":90},"correctness_checks":["所有显示点满足xy=k","象限与k符号一致","两坐标轴是渐近线","图像不接触坐标轴"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-creator"},"review":{"status":"parent_validated","notes":"父 agent 复核定义域、象限和渐近线。"}}
{"id":"function_007","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"advanced","topic":"连续但不可导的分段函数","prompt":"绘制 f(x)=x²（x<1）、f(x)=x（x≥1），展示 x=1 处连续但不可导。","teaching_goal":"区分函数连续性和可导性。","must_include":["左极限与右极限都为1","f(1)=1","左导数为2","右导数为1","连接点(1,1)"],"must_avoid":["把图像画成跳跃间断","声称左右导数相等","忽略端点归属"],"expected_scene_structure":["分别绘制两段","放大连接点","比较左右函数极限","显示左右割线趋向","总结连续但不可导"],"duration_seconds":{"min":65,"target":90,"max":120},"correctness_checks":["lim(x→1-)x²=1","lim(x→1+)x=1","左导数2右导数1","f(1)=1"],"ambiguities":["高中受众需已学左右导数"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核左右极限、函数值及左右导数。"}}
{"id":"function_008","category":"function_visualization","persona":"数学科普创作者","audience":"general_creator","difficulty":"introductory","topic":"绝对值函数尖点","prompt":"绘制 y=|x|，拆成 y=x 与 y=-x，并用左右割线斜率说明 x=0 处不可导。","teaching_goal":"理解绝对值的分段结构和尖点不可导。","must_include":["|x|=x（x≥0）","|x|=-x（x<0）","左导数-1","右导数1","尖点(0,0)"],"must_avoid":["在尖点绘制唯一普通切线","把左右导数都写成1","把函数画成平滑曲线"],"expected_scene_structure":["分别出现两条射线","组合为V形图像","左右割线逼近原点","标出两个斜率极限","得到不可导结论"],"duration_seconds":{"min":35,"target":55,"max":80},"correctness_checks":["f(0)=0","左侧斜率恒为-1","右侧斜率恒为1","左右导数不等"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-creator"},"review":{"status":"parent_validated","notes":"父 agent 复核分段定义与左右导数。"}}
{"id":"function_009","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"intermediate","topic":"三次函数切线","prompt":"在 y=x³ 上移动点 P(a,a³)，动态绘制切线并显示 y=3a²(x-a)+a³。","teaching_goal":"理解导数给出曲线上移动点处的切线斜率。","must_include":["f(x)=x³与f′(x)=3x²","移动点P(a,a³)","切线斜率3a²","切线方程y=3a²(x-a)+a³","a=0时切线y=0"],"must_avoid":["把斜率写成3a","切线不经过P","移动点离开曲线"],"expected_scene_structure":["绘制三次曲线","放置移动点","从割线过渡到切线","同步显示a和斜率","检查a=0等特殊位置"],"duration_seconds":{"min":60,"target":85,"max":110},"correctness_checks":["切线代入x=a得到a³","切线x系数为3a²","a=0时方程化为y=0"],"ambiguities":["a的动画范围限制在坐标窗口内"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核导数与点斜式切线方程。"}}
{"id":"function_010","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"advanced","topic":"导数符号与局部极值","prompt":"分析 f(x)=x³-3x，同时显示函数图像、导数图像和导数符号，标出局部极大值与局部极小值。","teaching_goal":"使用导数符号判断单调区间和局部极值。","must_include":["f′(x)=3x²-3=3(x-1)(x+1)","临界点x=-1与x=1","局部极大点(-1,2)","局部极小点(1,-2)","增区间与减区间"],"must_avoid":["把x=-1判为极小","认为导数为0必然有极值","遗漏任一临界点"],"expected_scene_structure":["绘制原函数","绘制或对齐导函数","标出导数零点","生成符号表和单调区间","回到原图标出极值"],"duration_seconds":{"min":85,"target":115,"max":145},"correctness_checks":["f(-1)=2且f(1)=-2","f′在(-∞,-1)和(1,∞)为正","f′在(-1,1)为负","极值类型正确"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核导数因式分解、符号和极值坐标。"}}
{"id":"function_011","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"advanced","topic":"二阶导数与凹凸性","prompt":"绘制 f(x)=x⁴-2x²，展示一阶导数、二阶导数、极值点和拐点，区分极值与凹凸性。","teaching_goal":"理解一阶导数控制增减，二阶导数控制凹凸变化。","must_include":["f′(x)=4x(x-1)(x+1)","f″(x)=12x²-4","极小点(-1,-1)与(1,-1)","局部极大点(0,0)","拐点(±1/√3,-5/9)"],"must_avoid":["把f″=0自动当作拐点而不检查变号","把(0,0)判为极小","拐点函数值写错"],"expected_scene_structure":["绘制原函数","用一阶导数确定极值","显示二阶导数零点","展示凹凸区间改变","标出两个拐点"],"duration_seconds":{"min":110,"target":145,"max":175},"correctness_checks":["f(±1)=-1且f(0)=0","f″在|x|<1/√3为负、外侧为正","f(±1/√3)=-5/9"],"ambiguities":["凹凸术语按课程约定统一"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核一二阶导数、极值和拐点坐标。"}}
{"id":"function_012","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"intermediate","topic":"定积分几何面积","prompt":"绘制 y=x² 在 [0,2] 与x轴围成的区域，用矩形逼近说明 ∫₀²x²dx=8/3。","teaching_goal":"理解定积分是黎曼和极限，并对应非负函数下方面积。","must_include":["曲线y=x²与区间[0,2]","分割矩形逐渐变细","黎曼和逼近","∫₀²x²dx=8/3","阴影区域非负"],"must_avoid":["面积写成4/3","阴影超出[0,2]","把有限个矩形面积说成精确积分"],"expected_scene_structure":["绘制边界和阴影","显示粗分割矩形","增加分割数量","矩形和趋近区域","用原函数计算8/3"],"duration_seconds":{"min":70,"target":100,"max":130},"correctness_checks":["原函数为x³/3","上下限代入得到8/3","矩形覆盖区间正确","极限与有限近似区分清楚"],"ambiguities":["可选左端点或右端点和，但必须标明"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核积分值、区域和近似/极限区别。"}}
{"id":"function_013","category":"function_visualization","persona":"数学科普创作者","audience":"general_creator","difficulty":"intermediate","topic":"有向面积与几何面积","prompt":"展示 y=sin x 在 [0,2π] 上方和下方的面积，说明定积分为0，但几何面积为4。","teaching_goal":"区分定积分的有向面积与普通几何面积。","must_include":["零点0、π、2π","∫₀^π sin x dx=2","∫_π^{2π} sin x dx=-2","∫₀^{2π} sin x dx=0","几何面积为4"],"must_avoid":["把下半部分几何面积称为-2","把总几何面积写成0","混淆积分值和面积"],"expected_scene_structure":["绘制一周期正弦曲线","高亮上方区域并计算2","高亮下方区域并显示积分-2","展示有向抵消","取绝对面积得到4"],"duration_seconds":{"min":60,"target":85,"max":110},"correctness_checks":["三个零点位置正确","上半积分2下半积分-2","总积分0","几何面积2+2=4"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-creator"},"review":{"status":"parent_validated","notes":"父 agent 复核两段积分和几何面积。"}}
{"id":"function_014","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"advanced","topic":"微积分基本定理可视化","prompt":"定义 F(x)=∫₀ˣt²dt，让上限x移动并显示 F(x)=x³/3 与 F′(x)=x²，说明累计面积的变化率等于当前高度。","teaching_goal":"用移动上限和新增面积直观理解微积分基本定理。","must_include":["固定曲线y=t²","移动上限x且限制x≥0","累计区域F(x)","F(x)=x³/3","F′(x)=x²并对应当前高度"],"must_avoid":["把F′(x)写成2x","混淆积分变量t和上限x","在x<0仍把有向积分简单称为正面积"],"expected_scene_structure":["显示t²曲线和起点0","移动上限并累积阴影","绘制或显示F(x)数值","突出新增窄条","连接当前高度与F′(x)"],"duration_seconds":{"min":90,"target":125,"max":155},"correctness_checks":["F(0)=0","积分结果x³/3","导数为x²","x≥0时累计面积单调增加"],"ambiguities":["首版仅用x≥0避免有向面积额外解释"],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核积分函数、导数和可视化范围。"}}
{"id":"function_015","category":"function_visualization","persona":"高中数学教师","audience":"k12","difficulty":"intermediate","topic":"复合函数与定义域","prompt":"分步骤展示 g(x)=x+1、f(u)=√u 和复合函数 f(g(x))=√(x+1)，重点标出复合函数定义域。","teaching_goal":"理解函数复合过程以及内层输出必须进入外层定义域。","must_include":["g(x)=x+1","f(u)=√u且u≥0","f(g(x))=√(x+1)","定义域x≥-1","端点(-1,0)和值域y≥0"],"must_avoid":["在x<-1绘制实数图像","把定义域写成x>-1","把√(x+1)写成√x+1"],"expected_scene_structure":["展示内函数输入输出","把输出送入根号函数","形成复合表达式","求x+1≥0","绘制从(-1,0)开始的图像"],"duration_seconds":{"min":55,"target":80,"max":105},"correctness_checks":["x+1≥0等价于x≥-1","最左端点包含(-1,0)","值域为[0,∞)","复合表达式正确"],"ambiguities":[],"source":{"type":"synthetic_interview","agent":"Mill (Luna)","interview_id":"synthetic-mill-teacher"},"review":{"status":"parent_validated","notes":"父 agent 复核复合表达式、定义域端点和值域。"}}
