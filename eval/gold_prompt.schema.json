{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manim-workbench.local/schemas/gold-prompt-v1.json",
  "title": "Phase1GoldPrompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "persona",
    "audience",
    "difficulty",
    "topic",
    "prompt",
    "teaching_goal",
    "must_include",
    "must_avoid",
    "expected_scene_structure",
    "duration_seconds",
    "correctness_checks",
    "ambiguities",
    "source",
    "review"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(formula|function)_[0-9]{3}$" },
    "category": {
      "type": "string",
      "enum": ["formula_derivation", "function_visualization"]
    },
    "persona": { "type": "string", "minLength": 1 },
    "audience": {
      "type": "string",
      "enum": ["k12", "college", "general_creator"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["introductory", "intermediate", "advanced"]
    },
    "topic": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "teaching_goal": { "type": "string", "minLength": 1 },
    "must_include": { "$ref": "#/$defs/nonEmptyStringArray" },
    "must_avoid": { "$ref": "#/$defs/nonEmptyStringArray" },
    "expected_scene_structure": { "$ref": "#/$defs/nonEmptyStringArray" },
    "duration_seconds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "target", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 30, "maximum": 180 },
        "target": { "type": "integer", "minimum": 30, "maximum": 180 },
        "max": { "type": "integer", "minimum": 30, "maximum": 180 }
      }
    },
    "correctness_checks": { "$ref": "#/$defs/nonEmptyStringArray" },
    "ambiguities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "agent", "interview_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["synthetic_interview", "real_interview"]
        },
        "agent": { "type": "string", "minLength": 1 },
        "interview_id": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "const": "parent_validated" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
