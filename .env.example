# Phase 6 DeepSeek credential; base URL and model are fixed in code
DEEPSEEK_API_KEY=your_api_key_here

# Phase 5 internal API/runner authentication (generate at least 32 random bytes locally)
MANIM_WORKBENCH_INTERNAL_TOKEN=replace_with_a_long_random_secret

# Phase 5 local infrastructure
MANIM_WORKBENCH_DATABASE_URL=sqlite:///./data/manim_workbench.db
MANIM_WORKBENCH_REDIS_URL=redis://127.0.0.1:6379/0
MANIM_WORKBENCH_API_URL=http://127.0.0.1:8000
MANIM_WORKBENCH_RUNNER_ID=runner-local-01
MANIM_WORKBENCH_RUNNER_ROOT=runtime/phase5

# Phase 8 browser session and artifact delivery boundaries
MANIM_WORKBENCH_SESSION_MAX_AGE_SECONDS=28800
MANIM_WORKBENCH_ALLOWED_ORIGINS=http://localhost:3000
MANIM_WORKBENCH_COOKIE_SECURE=false
MANIM_WORKBENCH_ARTIFACT_ROOT=runtime/phase5/artifacts
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
